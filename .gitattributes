# Line endings: normalize to LF in the repo; explicit rules below override.
* text=auto
*.cs text diff=csharp
*.md text
*.json text
*.sh text eol=lf
*.ps1 text eol=crlf

# Unity YAML files are text; route merges through UnityYAMLMerge
# (configure the merge driver in git config when scene merges become real).
*.unity text merge=unityyamlmerge
*.prefab text merge=unityyamlmerge
*.asset text merge=unityyamlmerge
*.meta text merge=unityyamlmerge
*.anim text merge=unityyamlmerge
*.controller text merge=unityyamlmerge
*.mat text merge=unityyamlmerge
*.physicsMaterial text merge=unityyamlmerge
*.physicsMaterial2D text merge=unityyamlmerge

# Known-binary .asset variants (override the text rule above) — Git LFS
*[Ll]ighting[Dd]ata.asset filter=lfs diff=lfs merge=lfs -text
*[Nn]av[Mm]esh.asset filter=lfs diff=lfs merge=lfs -text
*[Oo]cclusion[Cc]ulling[Dd]ata.asset filter=lfs diff=lfs merge=lfs -text
*[Tt]errain.asset filter=lfs diff=lfs merge=lfs -text

